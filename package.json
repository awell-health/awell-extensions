{
  "name": "@awell-health/awell-extensions",
  "version": "2.1.162",
  "packageManager": "yarn@4.5.3",
  "main": "dist/src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awell-health/awell-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/awell-health/awell-extensions/issues"
  },
  "homepage": "https://github.com/awell-health/awell-extensions#readme",
  "scripts": {
    "clean": "rimraf dist/* && echo 'Cleaned dist/'",
    "compile": "tsc",
    "build": "tsc -p tsconfig.build.json && echo 'Built new dist/' && yarn copy-markdown",
    "copy-markdown": "node copy-markdown.js && echo 'Copied markdown files to dist/'",
    "start": "node dist/src/index.js",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "test": "jest --verbose --testPathIgnorePatterns '.*\\.local\\.test\\.ts$'",
    "test-file": "jest --verbose --testPathIgnorePatterns='.*\\.local\\.test\\.ts$' --testPathPattern",
    "test-local": "jest --verbose",
    "prepack": "yarn build",
    "test-server": "ts-node-dev --respawn --transpile-only ./src/test-server.ts",
    "prepare": "husky",
    "generate-extension": "ts-node ./scripts/generate-extension.ts",
    "cli": "ts-node --transpile-only ./cli/src/index.ts"
  },
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "import": "./dist/src/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "require": "./dist/components/*/index.js",
      "import": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!**/*.test.ts",
    "!**/__tests__/**",
    "!**/__mocks__/**"
  ],
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
